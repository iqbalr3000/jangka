{
  "name": "@jangka/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup && tsx ../worker/scripts/copy-assets.ts dist/assets",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@jangka/db": "workspace:*",
    "@jangka/export": "workspace:*",
    "@jangka/llm": "workspace:*",
    "@jangka/permissions": "workspace:*",
    "@jangka/shared": "workspace:*",
    "@jangka/templates": "workspace:*",
    "@jangka/worker": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
