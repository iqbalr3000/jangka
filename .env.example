# Copy to .env for local development (pnpm dev).
# pnpm db:dev:up starts this database.
DATABASE_URL=postgres://jangka:jangka@localhost:5432/jangka

# Generate with: openssl rand -base64 32
MASTER_KEY=
PUBLIC_URL=http://localhost:5173
PORT=3000
LOG_LEVEL=debug
NODE_ENV=development
# SESSION_TTL_DAYS=30
# Offers a deterministic "Fake (testing)" LLM provider; for local dev without keys and e2e.
# ENABLE_FAKE_LLM=false
# api / worker / all. pnpm dev runs the worker as its own process, so the api only serves HTTP.
APP_ROLE=api

# Integration tests (pnpm test:db:up starts this database)
TEST_DATABASE_URL=postgres://jangka:jangka@localhost:54329/jangka_test
