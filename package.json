{
  "name": "jangka",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @jangka/db generate",
    "db:migrate": "pnpm --filter @jangka/db migrate",
    "db:dev:up": "docker compose -f docker/docker-compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "test:db:up": "docker compose -f docker/docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker/docker-compose.test.yml down",
    "test:e2e": "pnpm build && pnpm --filter @jangka/e2e test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
